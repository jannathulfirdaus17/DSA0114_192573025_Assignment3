#include <iostream>
#include <string>
class Prescription {
    int n;
    std::string* medicines;
public:
    explicit Prescription(int count)
        : n(count), medicines(new std::string[count]) {}
    // TODO 1: Deep copy constructor
    Prescription(const Prescription& other)
        : n(other.n), medicines(new std::string[other.n]) {
        for (int i = 0; i < n; i++) {
            medicines[i] = other.medicines[i];
        }
    }
    // TODO 2: Copy assignment operator
    Prescription& operator=(const Prescription& other) {
        if (this != &other) {
            std::string* temp = new std::string[other.n];
            for (int i = 0; i < other.n; i++) {
                temp[i] = other.medicines[i];
            }
            delete[] medicines;
            medicines = temp;
            n = other.n;
        }
        return *this;
    }
    // TODO 3: Destructor
    ~Prescription() {
        delete[] medicines;
    }
    void set(int i, const std::string& m) {
        medicines[i] = m;
    }
    std::string get(int i) const {
        return medicines[i];
    }
};
int main() {
    Prescription p(2);
    p.set(0, "Paracetamol");
    p.set(1, "ORS");
    // Copy constructor
    Prescription q = p;
    q.set(1, "Cetirizine");
    // Copy assignment operator
    Prescription r(1);
    r = p;
    p.set(0, "Ibuprofen");
    // Self-assignment test
    p = p;
    std::cout << "Original Prescription: " << p.get(0) << " " << p.get(1) << '\n';
    std::cout << "Copied using copy constructor: "  << q.get(0) << " " << q.get(1) << '\n';
    std::cout << "Copied using assignment operator: " << r.get(0) << " " << r.get(1) << '\n';
    std::cout << "Self-assignment test: "<< p.get(0) << " " << p.get(1) << '\n';
    return 0;
}
