#include <iostream>
#include <cmath>
#include <stdexcept>
#include <iomanip>
using namespace std;
class Complex {
private:
    double real;
    double imag;
public:
    // Default constructor
    Complex() {
        real = 0.0;
        imag = 0.0;
    }
    // Constructor with real part only
    Complex(double r) {
        real = r;
        imag = 0.0;
    }
    // Constructor with real and imaginary parts
    Complex(double r, double i) {
        real = r;
        imag = i;
    }
    // Addition
    Complex operator+(const Complex& other) const {
        return Complex(real + other.real,
                       imag + other.imag);
    }
    // Subtraction
    Complex operator-(const Complex& other) const {
        return Complex(real - other.real,
                       imag - other.imag);
    }
    // Multiplication
    Complex operator*(const Complex& other) const {
        return Complex(
            real * other.real - imag * other.imag,
            real * other.imag + imag * other.real
        );
    }
    // Division
    Complex operator/(const Complex& other) const {
        double denominator =
            other.real * other.real +
            other.imag * other.imag;
        if (denominator == 0.0) {
            throw runtime_error("Division by zero impedance");
        }
        return Complex(
            (real * other.real + imag * other.imag) / denominator,
            (imag * other.real - real * other.imag) / denominator
        );
    }
    // Equality
    bool operator==(const Complex& other) const {
        const double EPSILON = 1e-9;

        return fabs(real - other.real) < EPSILON &&
               fabs(imag - other.imag) < EPSILON;
    }
    // Magnitude
    double magnitude() const {
        return sqrt(real * real + imag * imag);
    }
    // Stream insertion
    friend ostream& operator<<(ostream& out,
                               const Complex& value) {
        out << fixed << setprecision(2)
            << value.real;
        if (value.imag >= 0)
            out << " + " << value.imag << "j";
        else
            out << " - " << fabs(value.imag) << "j";
        return out;
    }
};
int main() {
    cout << fixed << setprecision(2);
    cout << "--- Constructor Tests ---" << endl;
    Complex z1;
    Complex z2(5.0);
    Complex z3(3.0, 4.0);
    cout << "Default: " << z1 << endl;
    cout << "Real only: " << z2 << endl;
    cout << "Real and imaginary: " << z3 << endl;
    cout << "\n--- Basic Complex Operations ---" << endl;
    Complex a(4.0, 3.0);
    Complex b(2.0, -1.0);
    cout << "A = " << a << endl;
    cout << "B = " << b << endl;
    cout << "Addition: " << a + b << endl;
    cout << "Subtraction: " << a - b << endl;
    cout << "Multiplication: " << a * b << endl;
    cout << "Division: " << a / b << endl;
    cout << "Magnitude of A: " << a.magnitude() << endl;
    cout << "A == B: " << (a == b) << endl;
    cout << "\n--- Series RLC Circuit ---" << endl;
    // R = 10 ohms
    // Inductive reactance XL = 20 ohms
    // Capacitive reactance XC = 5 ohms
    Complex R(10.0, 0.0);
    Complex L(0.0, 20.0);
    Complex C(0.0, -5.0);
    Complex series = R + L + C;
    cout << "Resistor: " << R << endl;
    cout << "Inductor: " << L << endl;
    cout << "Capacitor: " << C << endl;
    cout << "Series impedance: " << series << endl;
    cout << "Series magnitude: " << series.magnitude()
         << " ohms" << endl;
    cout << "\n--- Parallel RLC Circuit ---" << endl;
    // Parallel combination of the same impedances
    Complex parallel = (R * L) / (R + L);
    cout << "R parallel L: " << parallel << endl;
    cout << "Magnitude: " << parallel.magnitude()
         << " ohms" << endl;
    // Parallel combination of R, L and C
    Complex parallelRLC =
        (R * L * C) /
        (R * L + L * C + C * R);
    cout << "R parallel L parallel C: "
         << parallelRLC << endl;
    cout << "Parallel RLC magnitude: "
         << parallelRLC.magnitude() << " ohms" << endl;
    cout << "\n--- Division by Zero Test ---" << endl;
    try {
        Complex zero(0.0, 0.0);
        Complex result = a / zero;
        cout << result << endl;
    }
    catch (const runtime_error& error) {
        cout << "Error handled: " << error.what() << endl;
    }
    cout << "\n--- Equality Test ---" << endl;
    Complex x(3.0, 4.0);
    Complex y(3.0, 4.0);
    cout << "X == Y: " << (x == y) << endl;
    cout << "\nProgram completed successfully." << endl;
    return 0;
}
